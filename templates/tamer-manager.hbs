<section class="tamer-manager__root">
  <header class="tamer-manager__header">
    <div>
      <h2>Companion Manager</h2>
      {{#if hasTamer}}
        <p class="tamer-manager__tamer">Managing companions for <strong>{{tamer.name}}</strong></p>
        <p class="tamer-manager__capacity">POCKET FAMILY <strong>{{companionCount}} / {{#if maxCompanions}}{{maxCompanions}}{{else}}—{{/if}}</strong></p>
      {{else}}
        <p class="tamer-manager__tamer">No Tamer selected</p>
      {{/if}}
    </div>
    <div class="tamer-manager__actions">
      {{#if canManage}}
        <button type="button" data-action="addCompanion"><i class="fa-solid fa-plus"></i> Add Companion</button>
      {{/if}}
      <button type="button" data-action="refresh" title="Refresh companion list" aria-label="Refresh"><i class="fa-solid fa-rotate"></i></button>
    </div>
  </header>

  <main class="tamer-manager__body">
    {{#if companions.length}}
      <div class="tamer-manager__companions">
        {{#each companions}}
          <article class="tamer-manager__card {{#unless actorExists}}is-missing{{/unless}}" data-record-id="{{id}}">
            <div class="tamer-manager__portrait-wrap">
              <img class="tamer-manager__portrait" src="{{portrait}}" alt="{{actorName}}" loading="lazy">
            </div>
            <div class="tamer-manager__details">
              <header class="tamer-manager__card-header">
                <div class="tamer-manager__identity">
                  <strong>{{actorName}}</strong>
                  <span class="tamer-manager__type">{{#if actorType}}{{actorType}}{{else}}Companion{{/if}}</span>
                </div>
                <span class="tamer-manager__slot">SLOT {{slot}}</span>
              </header>
              {{#if actorExists}}
                <div class="tamer-manager__stats">
                  <div><span class="tamer-manager__stat-label">HP</span><strong>{{#if hitPointsMax}}{{hitPoints}} / {{hitPointsMax}}{{else}}—{{/if}}</strong></div>
                  <div><span class="tamer-manager__stat-label">AC</span><strong>{{#if armorClass}}{{armorClass}}{{else}}—{{/if}}</strong></div>
                </div>
                <div class="tamer-manager__status">
                  <span class="tamer-manager__stat-label">CHALLENGE RATING</span>
                  <strong>{{#if challengeRating}}CR {{challengeRating}}{{else}}—{{/if}}</strong>
                  {{#if size}}<span>{{size}}</span>{{/if}}
                </div>
                <div class="tamer-manager__status">
                  <span class="tamer-manager__stat-label">VESSEL</span>
                  <strong>{{vesselName}}</strong>
                  <span>{{statusLabel}}</span>
                </div>
                <div class="tamer-manager__improvements">
                  <span class="tamer-manager__stat-label">IMPROVEMENTS</span>
                  <strong>{{selectedImprovements}} / {{#if availableImprovements}}{{availableImprovements}}{{else}}—{{/if}}</strong>
                  <span>Choose improvements on the companion sheet</span>
                </div>
              {{else}}
                <span class="tamer-manager__missing">Actor reference unavailable — relationship preserved</span>
                <span class="tamer-manager__reference">{{actorUuid}}</span>
              {{/if}}
            </div>
            <div class="tamer-manager__card-actions">
              {{#if actorExists}}
                <button type="button" data-action="openCompanion" data-actor-uuid="{{actorUuid}}" title="Open companion sheet">
                  <i class="fa-solid fa-up-right-from-square"></i><span class="visually-hidden">Open companion sheet</span>
                </button>
              {{/if}}
              <button type="button" data-action="removeCompanion" data-record-id="{{id}}" title="Unlink companion">
                <i class="fa-solid fa-link-slash"></i><span class="visually-hidden">Unlink companion</span>
              </button>
            </div>
          </article>
        {{/each}}
      </div>
    {{else}}
      <div class="tamer-manager__empty-state">
        <i class="fa-solid fa-paw" aria-hidden="true"></i>
        <h3>No bonded companions yet</h3>
        <p>Add an eligible NPC Actor to initialize it and register the relationship with this Tamer.</p>
      </div>
    {{/if}}
  </main>
</section>
