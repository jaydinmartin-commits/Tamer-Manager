<section class="tamer-manager tamer-manager__root">
  <header class="tamer-manager__header">
    <div>
      <h2>Companion Manager</h2>
      {{#if hasTamer}}
        <p class="tamer-manager__tamer">Managing companions for <strong>{{tamer.name}}</strong></p>
        <p class="tamer-manager__capacity">POCKET FAMILY <strong>{{companionCount}} / {{#if maxCompanions}}{{maxCompanions}}{{else}}—{{/if}}</strong></p>
        {{#if hasResources}}
          <div class="tamer-manager__resources" aria-label="Tamer resources">
            {{#each resources}}
              <div class="tamer-manager__resource"><span>{{name}}</span><strong>{{value}} / {{max}}</strong></div>
            {{/each}}
          </div>
        {{/if}}
      {{else}}
        <p class="tamer-manager__tamer">No Tamer selected</p>
      {{/if}}
    </div>
    <div class="tamer-manager__actions">
      {{#if canManage}}
        <button type="button" data-action="{{#if inSheetTab}}tamerAddCompanion{{else}}addCompanion{{/if}}"><i class="fa-solid fa-plus"></i> Add Companion</button>
      {{/if}}
      <button type="button" data-action="{{#if inSheetTab}}tamerRefresh{{else}}refresh{{/if}}" title="Refresh companion list" aria-label="Refresh"><i class="fa-solid fa-rotate"></i></button>
    </div>
  </header>

  <main class="tamer-manager__body">
    {{#if companions.length}}
      <div class="tamer-manager__companions">
        {{#each companions}}
          <article class="tamer-manager__card {{#unless actorExists}}is-missing{{/unless}} {{#if isSummonedBespoke}}is-summoned-bespoke{{/if}}" data-record-id="{{id}}">
            <div class="tamer-manager__portrait-wrap">
              <img class="tamer-manager__portrait" src="{{portrait}}" alt="{{actorName}}" loading="lazy">
            </div>
            <div class="tamer-manager__details">
              <header class="tamer-manager__card-header">
                <div class="tamer-manager__identity">
                  <strong>{{actorName}}</strong>
                  <span class="tamer-manager__type">{{#if actorType}}{{actorType}}{{else}}Companion{{/if}}</span>
                </div>
                <span class="tamer-manager__slot">SLOT {{slot}}</span>
              </header>
              {{#if actorExists}}
                <div class="tamer-manager__stats">
                  <div><span class="tamer-manager__stat-label">HP</span><strong>{{#if hitPointsMax}}{{hitPoints}} / {{hitPointsMax}}{{else}}—{{/if}}</strong></div>
                  <div><span class="tamer-manager__stat-label">AC</span><strong>{{#if armorClass}}{{armorClass}}{{else}}—{{/if}}</strong></div>
                </div>
                <div class="tamer-manager__status">
                  <span class="tamer-manager__stat-label">CHALLENGE RATING</span>
                  <strong>{{challengeRatingLabel}}</strong>
                  {{#if sizeLabel}}<span>{{sizeLabel}}</span>{{/if}}
                </div>
                <div class="tamer-manager__status">
                  <span class="tamer-manager__stat-label">VESSEL</span>
                  <strong>{{vesselName}}</strong>
                  <span>{{statusLabel}}</span>
                  <div class="tamer-manager__vessel-actions">
                    <button type="button" data-action="{{#if inSheetTab}}tamerAssignVessel{{else}}assignVessel{{/if}}" data-record-id="{{id}}" title="Assign a vessel">
                      <i class="fa-solid fa-box"></i> Assign
                    </button>
                    {{#if vesselUuid}}
                      <button type="button" data-action="{{#if inSheetTab}}tamerClearVessel{{else}}clearVessel{{/if}}" data-record-id="{{id}}" title="Clear vessel assignment">
                        <i class="fa-solid fa-xmark"></i> Clear
                      </button>
                    {{/if}}
                  </div>
                </div>
                <div class="tamer-manager__improvements">
                  <span class="tamer-manager__stat-label">IMPROVEMENTS</span>
                  <strong>{{improvementProgressLabel}}</strong>
                  {{#if hasImprovementDisplay}}
                    <ul class="tamer-manager__selected-improvements" aria-label="Selected improvements">
                      {{#each improvementDisplay}}
                        <li class="{{#if missingDefinition}}is-missing{{/if}}">{{label}}</li>
                      {{/each}}
                    </ul>
                  {{else}}
                    <span>No improvements selected</span>
                  {{/if}}
                  <button type="button" data-action="{{#if inSheetTab}}tamerManageImprovements{{else}}manageImprovements{{/if}}" data-record-id="{{id}}" title="Manage companion improvements" aria-label="Manage companion improvements"><i class="fa-solid fa-arrow-up-right-from-square"></i><span class="visually-hidden">Manage companion improvements</span></button>
                </div>
              {{else}}
                <span class="tamer-manager__missing">Actor reference unavailable — relationship preserved</span>
                <span class="tamer-manager__reference">{{actorUuid}}</span>
              {{/if}}
            </div>
            <div class="tamer-manager__card-actions">
              {{#if actorExists}}
                <button type="button" data-action="{{#if inSheetTab}}tamerToggleSummon{{else}}toggleSummon{{/if}}" data-record-id="{{id}}" title="{{#if isSummoned}}Return companion to storage{{else}}Summon companion to current scene{{/if}}">
                  {{#if isSummoned}}<i class="fa-solid fa-box"></i><span class="visually-hidden">Return to storage</span>{{else}}<i class="fa-solid fa-wand-sparkles"></i><span class="visually-hidden">Summon companion</span>{{/if}}
                </button>
                <button type="button" data-action="{{#if inSheetTab}}tamerOpenCompanion{{else}}openCompanion{{/if}}" data-actor-uuid="{{actorUuid}}" title="Open companion sheet">
                  <i class="fa-solid fa-up-right-from-square"></i><span class="visually-hidden">Open companion sheet</span>
                </button>
              {{/if}}
              <button type="button" data-action="{{#if inSheetTab}}tamerRemoveCompanion{{else}}removeCompanion{{/if}}" data-record-id="{{id}}" title="Unlink companion">
                <i class="fa-solid fa-link-slash"></i><span class="visually-hidden">Unlink companion</span>
              </button>
            </div>
          </article>
        {{/each}}
      </div>
    {{else}}
      <div class="tamer-manager__empty-state">
        <h3>No bonded companions yet</h3>
        <p>Add an eligible NPC Actor to initialize it and register the relationship with this Tamer.</p>
      </div>
    {{/if}}
  </main>
</section>
